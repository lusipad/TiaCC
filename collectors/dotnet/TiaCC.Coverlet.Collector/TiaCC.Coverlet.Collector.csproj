<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- NuGet Package Info -->
    <PackageId>TiaCC.Coverlet.Collector</PackageId>
    <Version>1.0.0</Version>
    <Authors>TiaCC Team</Authors>
    <Description>TiaCC Data Collector for per-test coverage collection. Automatically separates coverage data by test method for Test Impact Analysis.</Description>
    <PackageTags>tiacc;coverlet;coverage;testing;impact-analysis</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lusipad/TiaCC</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lusipad/TiaCC.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Build as DataCollector -->
    <IsTestProject>false</IsTestProject>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <ContentTargetFolders>build</ContentTargetFolders>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="17.8.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\**\*" Pack="true" PackagePath="build" />
  </ItemGroup>

</Project>
