<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <RootNamespace>TiaCC.Cli</RootNamespace>
    <AssemblyName>tiacc</AssemblyName>

    <Description>TiaCC CLI - Zero-dependency test impact analysis tool with built-in coverage collection</Description>
    <Authors>TiaCC Team</Authors>
    <Version>1.0.0</Version>

    <!-- 单文件发布设置 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- 裁剪未使用代码 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!-- AOT 编译选项（可选，进一步减小体积） -->
    <!-- <PublishAot>true</PublishAot> -->

    <!-- 禁用调试符号 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- 内置版本信息 -->
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <!-- 零依赖：不引用任何 NuGet 包 -->
  <!-- 所有功能内置实现 -->

</Project>
