{
  "name": "@tiacc/tools",
  "version": "1.0.0",
  "description": "TiaCC Test Impact Analysis Tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tia-mapper": "dist/cli/mapper.js",
    "tia-recommend": "dist/cli/recommend.js",
    "tia-runner": "dist/test-runner.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
